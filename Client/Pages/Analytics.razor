@page "/analytics"
@using InvestmentTracker.Shared.Models
@inject HttpClient Http

<h3>Portfolio Analytics</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5>Top Positions</h5>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Ticker</th><th>Value</th><th>Change</th></tr>
                    </thead>
                    <tbody>
                        @if (topPositions != null)
                        {
                            @foreach (var pos in topPositions)
                            {
                                <tr>
                                    <td>@pos.Ticker</td>
                                    <td>@pos.TotalValue.ToString("F2")</td>
                                    <td class="@(pos.ChangePercent >= 0 ? "text-success" : "text-danger")">@(pos.ChangePercent?.ToString("+0.00;-0.00;0.00") ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5>Allocation</h5>
                @if (summary?.Allocation != null)
                {
                    @foreach (var alloc in summary.Allocation)
                    {
                        <div class="mb-2">
                            <span>@alloc.AssetTypeName (@alloc.Percentage.ToString("F1")%)</span>
                            <div class="progress">
                                <div class="progress-bar" style="width: @alloc.Percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;">
                                    @alloc.TotalValue.ToString("C2")
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<TopPositionDto>? topPositions;
    private DashboardSummaryDto? summary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            topPositions = await Http.GetFromJsonAsync<List<TopPositionDto>>("api/portfolio/top5");
            summary = await Http.GetFromJsonAsync<DashboardSummaryDto>("api/portfolio/summary");
        }
        catch { }
    }
}