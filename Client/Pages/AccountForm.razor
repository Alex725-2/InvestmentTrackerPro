@page "/accounts/add"
@page "/accounts/edit/{Id:int}"
@using InvestmentTracker.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@Title</h3>

<EditForm Model="account" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Broker</label>
        <InputSelect @bind-Value="account.BrokerId" class="form-control" @bind-Value:after="OnBrokerChanged">
            <option value="">Select broker...</option>
            @foreach (var broker in brokers)
            {
                <option value="@broker.Id">@broker.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => account.BrokerId)" />
    </div>

    <div class="form-group">
        <label>Account Number</label>
        <InputText @bind-Value="account.AccountNumber" class="form-control" />
        <ValidationMessage For="@(() => account.AccountNumber)" />
    </div>

    <div class="form-group">
        <label>Comment</label>
        <InputText @bind-Value="account.Comment" class="form-control" />
    </div>

    <div class="form-group">
        <label>Currency</label>
        <InputSelect @bind-Value="account.CurrencyId" class="form-control">
            <option value="">Select currency...</option>
            @foreach (var currency in currencies)
            {
                <option value="@currency.Id">@currency.Code</option>
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label>Commission Rate, %</label>
        <InputNumber @bind-Value="account.CommissionRate" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private AccountDto account = new();
    private List<BrokerDto>? brokers;
    private List<CurrencyDto>? currencies;
    private string? errorMessage;

    private string Title => Id == 0 ? "New Account" : "Edit Account";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            brokers = await Http.GetFromJsonAsync<List<BrokerDto>>("api/brokers") ?? new();
            currencies = await Http.GetFromJsonAsync<List<CurrencyDto>>("api/currencies") ?? new();
        }
        catch
        {
            brokers = new();
            currencies = new();
        }

        if (Id == 0)
        {
            // Новый счёт: валюта по умолчанию RUR
            var defaultCurrency = currencies?.FirstOrDefault(c => c.Code == "RUR");
            if (defaultCurrency != null)
                account.CurrencyId = defaultCurrency.Id;
        }
        else
        {
            // Редактирование: загружаем существующий счёт
            try
            {
                var existing = await Http.GetFromJsonAsync<AccountDto>($"api/accounts/{Id}");
                if (existing != null)
                {
                    account = existing;
                }
            }
            catch
            {
                errorMessage = "Failed to load account.";
            }
        }
    }

    private void OnBrokerChanged()
    {
        var broker = brokers?.FirstOrDefault(b => b.Id == account.BrokerId);
        if (broker != null)
        {
            account.CommissionRate = broker.DefaultCommissionRate;
        }
        // Если валюта не выбрана, ставим RUR
        if (account.CurrencyId == 0)
        {
            var defaultCurrency = currencies?.FirstOrDefault(c => c.Code == "RUR");
            if (defaultCurrency != null)
                account.CurrencyId = defaultCurrency.Id;
        }
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        try
        {
            HttpResponseMessage response;
            if (Id == 0)
                response = await Http.PostAsJsonAsync("api/accounts", account);
            else
                response = await Http.PutAsJsonAsync($"api/accounts/{Id}", account);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/accounts");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void Cancel() => Navigation.NavigateTo("/accounts");
}