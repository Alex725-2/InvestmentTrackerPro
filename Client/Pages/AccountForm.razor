@page "/accounts/add"
@page "/accounts/edit/{Id:int}"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@(Id == 0 ? Localizer["NewAccount"] : Localizer["EditAccount"])</h3>

<EditForm Model="account" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>@Localizer["Brokers"]</label>
        <InputSelect @bind-Value="account.BrokerId" class="form-control">
            <option value="">@Localizer["SelectBroker"]</option>
            @foreach (var broker in brokers)
            {
                <option value="@broker.Id">@broker.Name</option>
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label>@Localizer["AccountNumber"]</label>
        <InputText @bind-Value="account.AccountNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label>@Localizer["Comment"]</label>
        <InputText @bind-Value="account.Comment" class="form-control" />
    </div>

    <div class="form-group">
        <label>@Localizer["Currency"]</label>
        <InputSelect @bind-Value="account.CurrencyId" class="form-control">
            <option value="">@Localizer["SelectCurrency"]</option>
            @foreach (var currency in currencies)
            {
                <option value="@currency.Id">@currency.Code</option>
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label>@Localizer["CommissionRate"]</label>
        <InputNumber @bind-Value="account.CommissionRate" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">@Localizer["Cancel"]</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    [Parameter] public int Id { get; set; }
    private AccountDto account = new();
    private List<BrokerDto>? brokers;
    private List<CurrencyDto>? currencies;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            brokers = await Http.GetFromJsonAsync<List<BrokerDto>>("api/brokers") ?? new();
            currencies = await Http.GetFromJsonAsync<List<CurrencyDto>>("api/currencies") ?? new();
        }
        catch { brokers = new(); currencies = new(); }

        if (Id != 0)
        {
            var existing = await Http.GetFromJsonAsync<AccountDto>($"api/accounts/{Id}");
            if (existing != null) account = existing;
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            HttpResponseMessage response;
            if (Id == 0) response = await Http.PostAsJsonAsync("api/accounts", account);
            else response = await Http.PutAsJsonAsync($"api/accounts/{Id}", account);
            if (response.IsSuccessStatusCode) Navigation.NavigateTo("/accounts");
        }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
    }

    private void Cancel() => Navigation.NavigateTo("/accounts");
}