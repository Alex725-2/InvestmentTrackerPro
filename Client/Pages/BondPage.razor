@page "/bond/{Ticker}"
@using InvestmentTracker.Shared.Models
@using InvestmentTracker.Client.Resources
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject IStringLocalizer<SharedResource> Localizer

@if (bond == null && error == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else if (bond != null)
{
    <div class="row">
        <div class="col-md-8">
            <h2>@bond.Name</h2>
            <p class="text-muted">
                Тикер: <strong>@bond.Ticker</strong>
                @if (!string.IsNullOrEmpty(bond.Isin))
                {
                    <span> | ISIN: @bond.Isin</span>
                }
                @if (!string.IsNullOrEmpty(bond.AssetTypeName))
                {
                    <span> | Тип: @bond.AssetTypeName</span>
                }
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/calendar" class="btn btn-outline-primary">← @Localizer["Calendar"]</a>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>@Localizer["PaymentHistory"]</h4>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="hidePast" checked="@hidePast" @onchange="ToggleHidePast">
            <label class="form-check-label" for="hidePast">@Localizer["HidePast"]</label>
        </div>
    </div>

    @if (events == null)
    {
        <p>@Localizer["Loading"]</p>
    }
    else if (filteredEvents.Count == 0)
    {
        <div class="alert alert-info">@Localizer["NoPayments"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Date"]</th>
                        <th>@Localizer["PaymentType"]</th>
                        <th>@Localizer["AmountPerUnit"]</th>
                        <th>@Localizer["Currency"]</th>
                        <th>@Localizer["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in filteredEvents)
                    {
                        var status = GetStatus(e.Date, e.IsEstimated);
                        <tr>
                            <td>@e.Date.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge @GetBadgeClass(e.Type)">@GetLocalizedType(e.Type)</span>
                            </td>
                            <td>@e.AmountPerUnit.ToString("F2")</td>
                            <td>@e.Currency</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(status)">@GetStatusText(status)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public string Ticker { get; set; } = string.Empty;

    private SecurityDto? bond;
    private List<PaymentEventDto>? events;
    private string? error;
    private bool hidePast = true;

    private List<PaymentEventDto> filteredEvents =>
        events?
            .Where(e => !hidePast || e.Date >= DateTime.Today)
            .OrderBy(e => e.Date)
            .ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBondInfo();
        await LoadPayments();
    }

    private async Task LoadBondInfo()
    {
        try
        {
            var info = await Http.GetFromJsonAsync<SecurityDto>($"api/securities/lookup?ticker={Ticker}");
            bond = info;
            if (bond == null) error = "Облигация не найдена";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadPayments()
    {
        try
        {
            var url = $"api/payments/upcoming?ticker={Ticker}&includePast=true&count=500";
            events = await Http.GetFromJsonAsync<List<PaymentEventDto>>(url) ?? new();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private enum PaymentStatus { Past, Confirmed, Estimated }

    private PaymentStatus GetStatus(DateTime date, bool isEstimated)
    {
        if (date < DateTime.Today) return PaymentStatus.Past;
        return isEstimated ? PaymentStatus.Estimated : PaymentStatus.Confirmed;
    }

    private string GetStatusText(PaymentStatus status) => status switch
    {
        PaymentStatus.Past => "Выплачено",
        PaymentStatus.Confirmed => "План",
        PaymentStatus.Estimated => "Прогноз",
        _ => ""
    };

    private string GetStatusBadgeClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Past => "bg-secondary",
        PaymentStatus.Confirmed => "bg-success",
        PaymentStatus.Estimated => "bg-warning text-dark",
        _ => ""
    };

    private string GetLocalizedType(string type) => type switch
    {
        "Dividend" => "Дивиденд",
        "Coupon" => "Купон",
        "Amortization" => "Амортизация",
        _ => type
    };

    private string GetBadgeClass(string type) => type switch
    {
        "Dividend" => "bg-success",
        "Coupon" => "bg-primary",
        "Amortization" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private async Task ToggleHidePast(ChangeEventArgs e)
    {
        hidePast = (bool)(e.Value ?? true);
    }
}