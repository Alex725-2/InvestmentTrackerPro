@page "/brokers"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["Brokers"]</h3>

@if (brokers == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["BrokerName"]</th>
                <th>@Localizer["SiteUrl"]</th>
                <th>@Localizer["DefaultCommission"]</th>
                <th>@Localizer["Approved"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var broker in brokers)
            {
                <tr>
                    <td>@broker.Name</td>
                    <td>@broker.SiteUrl</td>
                    <td>@broker.DefaultCommissionRate.ToString("F2")</td>
                    <td>@broker.IsApproved</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => NavigateToEdit(broker.Id)">@Localizer["Edit"]</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteBroker(broker.Id)">@Localizer["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<button class="btn btn-success mt-2" @onclick="NavigateToCreate">@Localizer["AddBroker"]</button>

@code {
    private List<BrokerDto>? brokers;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadBrokers();

    private async Task LoadBrokers()
    {
        try { brokers = await Http.GetFromJsonAsync<List<BrokerDto>>("api/brokers") ?? new(); errorMessage = null; }
        catch (Exception ex) { brokers = new(); errorMessage = $"Failed to load brokers: {ex.Message}"; }
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/brokers/add");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/brokers/edit/{id}");

    private async Task DeleteBroker(int id)
    {
        var response = await Http.DeleteAsync($"api/brokers/{id}");
        if (response.IsSuccessStatusCode) { await LoadBrokers(); StateHasChanged(); }
        else errorMessage = "Delete failed";
    }
}