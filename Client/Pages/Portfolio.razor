@page "/portfolio"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["MyPortfolio"]</h3>

@if (positions == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (positions.Count == 0)
{
    <p>@Localizer["NoPositions"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["SecurityName"]</th>
                <th>@Localizer["AccountNumber"]</th>
                <th>@Localizer["Quantity"]</th>
                <th>@Localizer["AvgPrice"]</th>
                <th>@Localizer["CurrentPrice"]</th>
                <th>@Localizer["TotalCost"]</th>
                <th>@Localizer["MarketValue"]</th>
                <th>@Localizer["PL"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pos in positions)
            {
                var cost = pos.Quantity * pos.AveragePurchasePrice;
                var marketValue = pos.Quantity * (pos.CurrentPrice ?? 0);
                var pl = marketValue - cost;
                <tr>
                    <td>@pos.SecurityTicker</td>
                    <td>@pos.AccountNumber</td>
                    <td>@pos.Quantity.ToString("F0")</td>
                    <td>@pos.AveragePurchasePrice.ToString("F2")</td>
                    <td>@(pos.CurrentPrice?.ToString("F2") ?? "—")</td>
                    <td>@cost.ToString("F2")</td>
                    <td>@(pos.CurrentPrice != null ? marketValue.ToString("F2") : "—")</td>
                    <td class="@(pl >= 0 ? "text-success" : "text-danger")">@(pos.CurrentPrice != null ? pl.ToString("F2") : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PortfolioItemDto>? positions;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadPositions();

    private async Task LoadPositions()
    {
        try { positions = await Http.GetFromJsonAsync<List<PortfolioItemDto>>("api/portfolio") ?? new(); errorMessage = null; }
        catch (Exception ex) { positions = new(); errorMessage = $"{Localizer["ErrorLoadingPortfolio"]}: {ex.Message}"; }
    }
}