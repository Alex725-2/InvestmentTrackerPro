@page "/transactions"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["MyTransactions"]</h3>

@if (transactions == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (transactions.Count == 0)
{
    <p>@Localizer["NoTransactions"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Date"]</th>
                <th>@Localizer["TransactionType"]</th>
                <th>@Localizer["SecurityName"]</th>
                <th>@Localizer["AccountNumber"]</th>
                <th>@Localizer["Quantity"]</th>
                <th>@Localizer["Price"]</th>
                <th>@Localizer["Commission"]</th>
                <th>@Localizer["Total"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in transactions)
            {
                var total = t.Quantity * t.Price;
                <tr>
                    <td>@t.Date.ToShortDateString()</td>
                    <td>@(t.Type == TransactionType.Buy ? Localizer["Buy"] : Localizer["Sell"])</td>
                    <td>@t.SecurityTicker</td>
                    <td>@t.AccountNumber</td>
                    <td>@t.Quantity</td>
                    <td>@t.Price.ToString("F2")</td>
                    <td>@t.Commission.ToString("F2")</td>
                    <td>@total.ToString("F2")</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteTransaction(t.Id)">@Localizer["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<button class="btn btn-success mt-2" @onclick="NavigateToCreate">@Localizer["AddTransaction"]</button>

@code {
    private List<TransactionDto>? transactions;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadTransactions();

    private async Task LoadTransactions()
    {
        try { transactions = await Http.GetFromJsonAsync<List<TransactionDto>>("api/transactions") ?? new(); errorMessage = null; }
        catch (Exception ex) { transactions = new(); errorMessage = $"Error loading transactions: {ex.Message}"; }
    }

    private async Task DeleteTransaction(int id)
    {
        var response = await Http.DeleteAsync($"api/transactions/{id}");
        if (response.IsSuccessStatusCode) { await LoadTransactions(); StateHasChanged(); }
        else errorMessage = "Delete failed";
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/transactions/add");
}