@page "/transactions/add"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["NewTransaction"]</h3>

<EditForm Model="dto" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>@Localizer["TransactionType"]</label>
        <InputSelect @bind-Value="dto.Type" class="form-control">
            <option value="@TransactionType.Buy">@Localizer["Buy"]</option>
            <option value="@TransactionType.Sell">@Localizer["Sell"]</option>
        </InputSelect>
    </div>

    <div class="form-group">
        <label>@Localizer["SecurityName"]</label>
        <InputSelect @bind-Value="dto.SecurityId" class="form-control" @bind-Value:after="OnSecurityChanged">
            <option value="">@Localizer["SelectSecurity"]</option>
            @foreach (var sec in securities)
            {
                <option value="@sec.Id">@sec.Ticker</option>
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label>@Localizer["AccountNumber"]</label>
        <InputSelect @bind-Value="dto.AccountId" class="form-control" @bind-Value:after="OnAccountChanged">
            <option value="">@Localizer["SelectAccount"]</option>
            @foreach (var acc in accounts)
            {
                <option value="@acc.Id">@acc.AccountNumber (@acc.BrokerName)</option>
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label>@Localizer["Date"]</label>
        <InputDate @bind-Value="dto.Date" class="form-control" />
    </div>

    <div class="form-group">
        <label>@Localizer["Quantity"]</label>
        <InputNumber @bind-Value="dto.Quantity" class="form-control" min="1" />
    </div>

    <div class="form-group">
        <label>@Localizer["PricePerShare"]</label>
        <InputNumber @bind-Value="dto.Price" class="form-control" step="0.01" />
    </div>

    <div class="form-group">
        <label>@Localizer["Commission"]</label>
        <InputNumber @bind-Value="dto.Commission" class="form-control" step="0.01" />
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">@Localizer["Cancel"]</button>
</EditForm>

@if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    private TransactionDto dto = new();
    private List<SecurityDto>? securities;
    private List<AccountDto>? accounts;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            securities = await Http.GetFromJsonAsync<List<SecurityDto>>("api/securities") ?? new();
            accounts = await Http.GetFromJsonAsync<List<AccountDto>>("api/accounts") ?? new();
        }
        catch (Exception ex) { errorMessage = $"Failed to load references: {ex.Message}"; securities = new(); accounts = new(); }
        if (accounts.Count == 1) { dto.AccountId = accounts[0].Id; await OnAccountChanged(); }
    }

    private async Task OnAccountChanged()
    {
        var account = accounts?.FirstOrDefault(a => a.Id == dto.AccountId);
        if (account != null) dto.Commission = account.CommissionRate;
    }

    private async Task OnSecurityChanged()
    {
        try { var price = await Http.GetFromJsonAsync<decimal?>($"api/securities/{dto.SecurityId}/price"); if (price.HasValue) dto.Price = price.Value; } catch { }
    }

    private async Task HandleSubmit()
    {
        dto.DateString = dto.Date.ToString("yyyy-MM-dd");   // <-- обязательно для правильной даты на сервере

        try
        {
            var response = await Http.PostAsJsonAsync("api/transactions", dto);
            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo("/transactions");
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void Cancel() => Navigation.NavigateTo("/transactions");
}