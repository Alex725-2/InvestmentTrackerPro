@page "/admin"
@using InvestmentTracker.Client.Services
@using InvestmentTracker.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize(Roles = "Admin")]
@inject IAuthService AuthService
@inject NavigationManager Navigation

<h3>@Localizer["AdminPanel"]</h3>

<div class="card mb-4">
    <div class="card-body">
        <h5>@Localizer["MigrationHistory"]</h5>
        <button class="btn btn-secondary mb-2" @onclick="LoadMigrationHistory">@Localizer["Refresh"]</button>
        @if (migrationHistory != null && migrationHistory.Count > 0)
        {
            <table class="table table-sm">
                <thead><tr><th>MigrationId</th><th>ProductVersion</th></tr></thead>
                <tbody>
                    @foreach (var m in migrationHistory)
                    {
                        <tr><td>@m.MigrationId</td><td>@m.ProductVersion</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>@Localizer["NoMigrations"]</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5>Test Table</h5>
        @if (testData != null)
        {
            <ul>
                @foreach (var item in testData)
                {
                    <li>@item.Id - @item.Name</li>
                }
            </ul>
        }
    </div>
</div>
<!-- Загрузка дивидендов -->
<div class="card mb-4">
    <div class="card-body">
        <h5>@Localizer["LoadDividends"]</h5>
        <div class="row">
            <div class="col-md-4">
                <label>@Localizer["Month"]</label>
                <select @bind="selectedMonth" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label>@Localizer["Year"]</label>
                <input @bind="selectedYear" type="number" class="form-control" min="2000" max="2100" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="LoadDividends" disabled="@isDividendsLoading">
                    @(isDividendsLoading? Localizer["Loading"] : Localizer["Load"])
                </button>
            </div>
        </div>
        @if (isDividendsLoading)
        {
            <div class="progress mt-2">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
            </div>
        }
        @if (!string.IsNullOrEmpty(dividendMessage))
        {
            <div class="alert @(dividendIsError ? "alert-danger" : "alert-success") mt-3">@dividendMessage</div>
        }
    </div>
</div>

<!-- Загрузка облигаций -->
<div class="card mb-4">
    <div class="card-body">
        <h5>@Localizer["LoadBonds"]</h5>
        <p>@Localizer["LoadBondsDescription"]</p>
        <button class="btn btn-primary" @onclick="LoadBonds" disabled="@isBondsLoading">
            @(isBondsLoading? Localizer["Loading"] : Localizer["LoadBondsButton"])
        </button>
        @if (isBondsLoading)
        {
            <div class="progress mt-2">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
            </div>
        }
        @if (!string.IsNullOrEmpty(bondsMessage))
        {
            <div class="alert @(bondsIsError ? "alert-danger" : "alert-success") mt-3">@bondsMessage</div>
        }
    </div>
</div>

<!-- Загрузка купонов/амортизаций -->
<div class="card mb-4">
    <div class="card-body">
        <h5>@Localizer["LoadBondPayments"]</h5>
        <p>@Localizer["LoadBondPaymentsDesc"]</p>
        <button class="btn btn-primary" @onclick="LoadBondPayments" disabled="@isBondPaymentsLoading">
            @(isBondPaymentsLoading? Localizer["Loading"] : Localizer["LoadBondPaymentsButton"])
        </button>
        @if (isBondPaymentsLoading)
        {
            <div class="progress mt-2">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
            </div>
        }
        @if (!string.IsNullOrEmpty(bondPaymentsMessage))
        {
            <div class="alert @(bondPaymentsIsError ? "alert-danger" : "alert-success") mt-3">@bondPaymentsMessage</div>
        }
    </div>
</div>

<!-- Диагностика одной облигации -->
<div class="card mb-4">
    <div class="card-body">
        <h5>Диагностика облигации</h5>
        <div class="row">
            <div class="col-md-4">
                <label>Тикер</label>
                <input @bind="debugTicker" class="form-control" placeholder="SU26238RMFS4" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-secondary" @onclick="DebugBond">Проверить</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(debugResult))
        {
            <pre class="mt-2 bg-light p-2">@debugResult</pre>
        }
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <h5>Уведомления</h5>
            <button class="btn btn-secondary" @onclick="SendTestEmail">Отправить тестовое письмо</button>
            @if (!string.IsNullOrEmpty(testEmailResult))
            {
                <div class="alert @(testEmailSuccess ? "alert-success" : "alert-danger") mt-2">@testEmailResult</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@Localizer["Settings"]</h5>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="notifyNewUser" checked="@notifyNewUser" @onchange="ToggleNotifyNewUser" />
                <label class="form-check-label" for="notifyNewUser">@Localizer["NotifyNewUser"]</label>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Очистка выплат</h5>
            <p class="text-muted">Удаляет все записи из таблицы PaymentEvents. Используйте с осторожностью.</p>
            <button class="btn btn-danger" @onclick="ClearPayments" disabled="@isClearing">
                @(isClearing ? "Удаление..." : "Очистить все выплаты")
            </button>
            @if (!string.IsNullOrEmpty(clearPaymentsMessage))
            {
                <div class="alert @(clearPaymentsSuccess ? "alert-success" : "alert-danger") mt-2">@clearPaymentsMessage</div>
            }
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <h5>Диагностика по ISIN (загрузить купоны/амортизации для конкретной бумаги)</h5>
            <div class="row">
                <div class="col-md-4">
                    <label>ISIN или тикер</label>
                    <input @bind="debugIsin" class="form-control" placeholder="RU000A10CU55" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-secondary" @onclick="DebugBondByIsin">Загрузить</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(debugBondResult))
            {
                <pre class="mt-2 bg-light p-2">@debugBondResult</pre>
            }
        </div>
    </div>
</div>

@code {
    private int selectedMonth = DateTime.Now.Month;
    private int selectedYear = DateTime.Now.Year;
    private bool isDividendsLoading;
    private string? dividendMessage;
    private bool dividendIsError;

    private bool isBondsLoading;
    private string? bondsMessage;
    private bool bondsIsError;

    private bool isBondPaymentsLoading;
    private string? bondPaymentsMessage;
    private bool bondPaymentsIsError;

    private string debugTicker = "SU26238RMFS4";
    private string? debugResult;

    private bool testEmailSuccess;
    private string? testEmailResult;

    private bool notifyNewUser = true;

    private bool isClearing;
    private string? clearPaymentsMessage;
    private bool clearPaymentsSuccess;
    private string debugIsin = "";
    private string? debugBondResult;

    private List<MigrationHistoryDto>? migrationHistory;
    private async Task LoadMigrationHistory()
    {
        try
        {
            migrationHistory = await Http.GetFromJsonAsync<List<MigrationHistoryDto>>("api/admin/migration-history");
        }
        catch { migrationHistory = new(); }
    }

    private async Task DebugBondByIsin()
    {
        debugBondResult = null;
        StateHasChanged();
        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromMinutes(2) };
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await client.PostAsJsonAsync("api/admin/debug-bond-by-isin", new { Isin = debugIsin });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                debugBondResult = result;
            }
            else
            {
                debugBondResult = $"Ошибка: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            debugBondResult = $"Ошибка: {ex.Message}";
        }
    }

    private async Task ClearPayments()
    {
        isClearing = true;
        clearPaymentsMessage = null;
        StateHasChanged();

        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromMinutes(2) };
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await client.PostAsync("api/admin/clear-payments", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ClearResult>();
                clearPaymentsMessage = $"Удалено записей: {result?.Deleted ?? 0}";
                clearPaymentsSuccess = true;
            }
            else
            {
                clearPaymentsMessage = $"Ошибка: {await response.Content.ReadAsStringAsync()}";
                clearPaymentsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            clearPaymentsMessage = $"Ошибка: {ex.Message}";
            clearPaymentsSuccess = false;
        }
        finally
        {
            isClearing = false;
            StateHasChanged();
        }
    }

    private class ClearResult
    {
        public int Deleted { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // ... существующий код ...
        await LoadTestData();
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            var response = await Http.GetAsync("api/admin/settings?code=SendNotificationAboutNewUser");
            if (response.IsSuccessStatusCode)
            {
                var value = await response.Content.ReadAsStringAsync();
                notifyNewUser = bool.Parse(value);
            }
        }
        catch { }
    }

    private async Task ToggleNotifyNewUser(ChangeEventArgs e)
    {
        notifyNewUser = (bool)(e.Value ?? false);
        await Http.PutAsync($"api/admin/settings?code=SendNotificationAboutNewUser&enabled={notifyNewUser}", null);
    }

    private async Task SendTestEmail()
    {
        testEmailResult = null;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync("api/admin/test-email", null);
            if (response.IsSuccessStatusCode)
            {
                testEmailResult = "Письмо отправлено!";
                testEmailSuccess = true;
            }
            else
            {
                testEmailResult = $"Ошибка: {await response.Content.ReadAsStringAsync()}";
                testEmailSuccess = false;
            }
        }
        catch (Exception ex)
        {
            testEmailResult = $"Ошибка: {ex.Message}";
            testEmailSuccess = false;
        }
    }

    private async Task DebugBond()
    {
        debugResult = null;
        StateHasChanged();
        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromMinutes(2) };
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var request = new { Ticker = debugTicker };
            var response = await client.PostAsJsonAsync("api/admin/debug-bond", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                debugResult = result;
            }
            else
            {
                debugResult = $"Ошибка: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            debugResult = $"Ошибка: {ex.Message}";
        }
    }

    private async Task LoadBondPayments()
    {
        isBondPaymentsLoading = true;
        bondPaymentsMessage = null;
        bondPaymentsIsError = false;
        StateHasChanged();

        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromMinutes(20) }; // может быть долго
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await client.PostAsync("api/admin/load-bond-payments", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BondPaymentsResult>();
                bondPaymentsMessage = $"Купонов добавлено: {result?.CouponsAdded ?? 0}, амортизаций: {result?.AmortizationsAdded ?? 0}";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                bondPaymentsMessage = $"Ошибка: {errorContent}";
                bondPaymentsIsError = true;
            }
        }
        catch (TaskCanceledException)
        {
            bondPaymentsMessage = "Загрузка прервана (таймаут). Попробуйте ещё раз.";
            bondPaymentsIsError = true;
        }
        catch (Exception ex)
        {
            bondPaymentsMessage = $"Ошибка: {ex.Message}";
            bondPaymentsIsError = true;
        }
        finally
        {
            isBondPaymentsLoading = false;
            StateHasChanged();
        }
    }

    private class BondPaymentsResult
    {
        public int CouponsAdded { get; set; }
        public int AmortizationsAdded { get; set; }
    }

    private async Task LoadDividends()
    {
        isDividendsLoading = true;
        dividendMessage = null;
        dividendIsError = false;
        StateHasChanged();

        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromMinutes(5) };
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var request = new { Year = selectedYear, Month = selectedMonth };
            var response = await client.PostAsJsonAsync("api/admin/load-dividends", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoadResult>();
                dividendMessage = $"Загружено {result?.Added ?? 0} дивидендов за {result?.Month}/{result?.Year}";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                dividendMessage = $"Ошибка: {errorContent}";
                dividendIsError = true;
            }
        }
        catch (TaskCanceledException)
        {
            dividendMessage = "Загрузка прервана (таймаут). Попробуйте ещё раз.";
            dividendIsError = true;
        }
        catch (Exception ex)
        {
            dividendMessage = $"Ошибка: {ex.Message}";
            dividendIsError = true;
        }
        finally
        {
            isDividendsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadBonds()
    {
        isBondsLoading = true;
        bondsMessage = null;
        bondsIsError = false;
        StateHasChanged();

        try
        {
            using var client = new HttpClient { Timeout = TimeSpan.FromMinutes(5) };
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await client.PostAsync("api/admin/load-bonds", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoadResult>();
                bondsMessage = $"Добавлено облигаций: {result?.Added ?? 0}";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                bondsMessage = $"Ошибка: {errorContent}";
                bondsIsError = true;
            }
        }
        catch (TaskCanceledException)
        {
            bondsMessage = "Загрузка прервана (таймаут). Попробуйте ещё раз.";
            bondsIsError = true;
        }
        catch (Exception ex)
        {
            bondsMessage = $"Ошибка: {ex.Message}";
            bondsIsError = true;
        }
        finally
        {
            isBondsLoading = false;
            StateHasChanged();
        }
    }

    private class LoadResult
    {
        public int Added { get; set; }
        public int Month { get; set; }
        public int Year { get; set; }
    }

    private List<TestRecordDto>? testData;
    private async Task LoadTestData()
    {
        try
        {
            testData = await Http.GetFromJsonAsync<List<TestRecordDto>>("api/admin/test-records");
        }
        catch { testData = new(); }
    }
}