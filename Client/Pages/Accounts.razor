@page "/accounts"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["MyAccounts"]</h3>

@if (accounts == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Brokers"]</th>
                <th>@Localizer["AccountNumber"]</th>
                <th>@Localizer["Comment"]</th>
                <th>@Localizer["Currency"]</th>
                <th>@Localizer["CommissionRate"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var acc in accounts)
            {
                <tr>
                    <td>@acc.BrokerName</td>
                    <td>@acc.AccountNumber</td>
                    <td>@acc.Comment</td>
                    <td>@acc.CurrencyCode</td>
                    <td>@acc.CommissionRate.ToString("F2")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => NavigateToEdit(acc.Id)">@Localizer["Edit"]</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAccount(acc.Id)">@Localizer["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<button class="btn btn-success mt-2" @onclick="NavigateToCreate">@Localizer["AddAccount"]</button>

@code {
    private List<AccountDto>? accounts;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAccounts();

    private async Task LoadAccounts()
    {
        try { accounts = await Http.GetFromJsonAsync<List<AccountDto>>("api/accounts") ?? new(); errorMessage = null; }
        catch (Exception ex) { accounts = new(); errorMessage = $"Failed to load accounts: {ex.Message}"; }
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/accounts/add");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/accounts/edit/{id}");

    private async Task DeleteAccount(int id)
    {
        var response = await Http.DeleteAsync($"api/accounts/{id}");
        if (response.IsSuccessStatusCode) { await LoadAccounts(); StateHasChanged(); }
        else errorMessage = "Delete failed";
    }
}