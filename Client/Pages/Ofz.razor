@page "/ofz"
@using InvestmentTracker.Shared.Models
@using InvestmentTracker.Client.Resources
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["AllOfz"]</h3>

@if (ofz == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (!ofz.Any())
{
    <p>@Localizer["NoData"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Ticker"]</th>
                <th>@Localizer["ISIN"]</th>
                <th>@Localizer["SecurityName"]</th>
                <th>@Localizer["NextCouponDate"]</th>
                <th>@Localizer["FaceValue"]</th>
                <th>@Localizer["IssueSize"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bond in ofz)
            {
                <tr>
                    <td><a href="/bond/@bond.Ticker">@bond.Ticker</a></td>
                    <td>@bond.Isin</td>
                    <td>@bond.Name</td>
                    <td>@(bond.NextCouponDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@(bond.FaceValue?.ToString("F2") ?? "—")</td>
                    <td>@(bond.IssueSize?.ToString("N0") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SecurityDto>? ofz;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ofz = await Http.GetFromJsonAsync<List<SecurityDto>>("api/securities/ofz");
        }
        catch { ofz = new(); }
    }
}