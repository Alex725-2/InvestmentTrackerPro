@page "/securities/add"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["NewSecurity"]</h3>

<EditForm Model="security" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>@Localizer["Ticker"]</label>
        <InputText @bind-Value="security.Ticker" class="form-control" @onblur="LookupSecurity" />
        <ValidationMessage For="@(() => security.Ticker)" />
        @if (!string.IsNullOrEmpty(lookupError))
        {
            <span class="text-danger">@lookupError</span>
        }
    </div>

    <div class="form-group">
        <label>@Localizer["ISIN"]</label>
        <InputText @bind-Value="security.Isin" class="form-control" />
    </div>
    <div class="form-group">
        <label>@Localizer["SecurityName"]</label>
        <InputText @bind-Value="security.Name" class="form-control" />
        <ValidationMessage For="@(() => security.Name)" />
    </div>
    <div class="form-group">
        <label>@Localizer["AssetType"]</label>
        <InputSelect @bind-Value="security.AssetTypeId" class="form-control">
            <option value="">@Localizer["SelectAssetType"]</option>
            @foreach (var type in assetTypes)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => security.AssetTypeId)" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@(isTickerValid != true)">@Localizer["Save"]</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">@Localizer["Cancel"]</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    private SecurityDto security = new();
    private List<AssetTypeDto>? assetTypes;
    private string? lookupError;
    private string? errorMessage;
    private bool? isTickerValid;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            assetTypes = await Http.GetFromJsonAsync<List<AssetTypeDto>>("api/assettypes") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки типов активов: {ex.Message}";
            assetTypes = new();
        }
    }

    private async Task LookupSecurity()
    {
        if (string.IsNullOrWhiteSpace(security.Ticker))
        {
            isTickerValid = null;
            lookupError = null;
            return;
        }

        security.Ticker = security.Ticker.Trim().ToUpperInvariant();

        lookupError = null;
        isTickerValid = null;
        try
        {
            var info = await Http.GetFromJsonAsync<SecurityDto>($"api/securities/lookup?ticker={security.Ticker}");
            if (info != null)
            {
                security.Ticker = info.Ticker;
                security.Isin = info.Isin;
                security.Name = info.Name;
                security.AssetTypeId = info.AssetTypeId;
                isTickerValid = true;
                lookupError = null;
            }
            else
            {
                lookupError = Localizer["TickerNotFound"];
                isTickerValid = false;
                security.Isin = null;
                security.Name = string.Empty;
                security.AssetTypeId = 0;
            }
        }
        catch (HttpRequestException)
        {
            lookupError = Localizer["TickerNotFound"];
            isTickerValid = false;
            security.Isin = null;
            security.Name = string.Empty;
            security.AssetTypeId = 0;
        }
    }

    private async Task HandleSubmit()
    {
        if (isTickerValid != true)
        {
            errorMessage = Localizer["TickerRequired"];
            return;
        }

        if (security.AssetTypeId == 0)
        {
            errorMessage = Localizer["SelectAssetType"];
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/securities", security);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/securities");
            }
            else
            {
                errorMessage = Localizer["SecurityNotFound"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
    }

    private void Cancel() => Navigation.NavigateTo("/securities");
}