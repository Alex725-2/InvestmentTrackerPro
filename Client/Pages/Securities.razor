@page "/securities"
@using InvestmentTracker.Shared.Models
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<h3>@Localizer["Securities"]</h3>

@* --- Фильтры --- *@
<div class="row mb-3">
    <div class="col-md-3">
        <label class="form-label">@Localizer["AssetType"]</label>
        <select @bind="selectedAssetTypeId" class="form-select">
            <option value="">@Localizer["All"]</option>
            @if (assetTypes != null)
            {
                @foreach (var type in assetTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">@Localizer["Search"]</label>
        <input @bind="searchText" @bind:event="oninput" class="form-control" placeholder="@Localizer["SearchPlaceholder"]" />
    </div>
</div>

@* --- Список бумаг --- *@
@if (securities == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    var filtered = filteredSecurities;
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Ticker"]</th>
                <th>@Localizer["ISIN"]</th>
                <th>@Localizer["SecurityName"]</th>
                <th>@Localizer["AssetType"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sec in filtered)
            {
                if (sec == null) continue;
                <tr>
                    <td>@sec.Ticker</td>
                    <td>@(sec.Isin ?? "—")</td>
                    <td>@sec.Name</td>
                    <td>@(sec.AssetTypeName ?? "—")</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteSecurity(sec.Id)">@Localizer["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="text-muted">@Localizer["Total"]: @filtered.Count</div>
}

<button class="btn btn-success mt-2" @onclick="NavigateToCreate">@Localizer["AddSecurity"]</button>

@code {
    private List<SecurityDto>? securities;
    private string? errorMessage;
    private string selectedAssetTypeId = "";
    private string searchText = "";
    private List<AssetTypeDto>? assetTypes;

    // Вычисляемое свойство с защитой от null
    private List<SecurityDto> filteredSecurities
    {
        get
        {
            if (securities == null) return new List<SecurityDto>();
            var query = securities.AsEnumerable();
            if (!string.IsNullOrEmpty(selectedAssetTypeId))
                query = query.Where(s => s?.AssetTypeId.ToString() == selectedAssetTypeId);
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(s =>
                    s != null &&
                    ((s.Ticker?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                     (s.Isin?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                     (s.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true)));
            }
            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Инициализируем списки, чтобы избежать null
        securities = new List<SecurityDto>();
        assetTypes = new List<AssetTypeDto>();
        await LoadSecurities();
        await LoadAssetTypes();
    }

    private async Task LoadSecurities()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<SecurityDto>>("api/securities");
            securities = data ?? new List<SecurityDto>();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            securities = new List<SecurityDto>();
            errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
    }

    private async Task LoadAssetTypes()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<AssetTypeDto>>("api/assettypes");
            assetTypes = data ?? new List<AssetTypeDto>();
        }
        catch
        {
            assetTypes = new List<AssetTypeDto>();
        }
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/securities/add");

    private async Task DeleteSecurity(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/securities/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadSecurities();
                StateHasChanged();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Ошибка удаления: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
    }
}