@page "/"
@using System.Security.Claims
@using InvestmentTracker.Shared.Models
@using InvestmentTracker.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using Microsoft.Extensions.Localization
@using InvestmentTracker.Client.Resources
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable

<div class="container-fluid">
    @if (isAuthenticated)
    {
        <div class="row mb-3">
            <div class="col">
                <h1 class="d-inline">@Localizer["Welcome"], @userName!</h1>
                <button class="btn btn-danger ms-3" @onclick="Logout">
                    <span class="oi oi-account-logout"></span> @Localizer["Logout"]
                </button>
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="row mb-3">
                <div class="col">
                    <div class="alert alert-info d-flex align-items-center">
                        <strong>@Localizer["Admin"]:</strong>
                        <a href="/swagger" target="_blank" class="btn btn-sm btn-outline-primary ms-2">@Localizer["Swagger"]</a>
                        <a href="/admin/users" class="btn btn-sm btn-outline-primary ms-2">@Localizer["AdminUsers"]</a>
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="CopyToken">@Localizer["CopyToken"]</button>
                    </div>
                    @if (copied)
                    {
                        <div class="alert alert-success mt-2">Токен скопирован в буфер обмена</div>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(globalError))
        {
            <div class="alert alert-danger">@globalError</div>
        }

        <div class="row">
            <!-- Топ-5 позиций -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">📈 @Localizer["TopPositions"]</h5>
                        @if (topPositions == null)
                        {
                            <p class="text-muted">@Localizer["Loading"]</p>
                        }
                        else if (topPositions.Count == 0)
                        {
                            <p class="text-muted">@Localizer["NoPositions"]</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var pos in topPositions)
                                {
                                    var priceStr = pos.CurrentPrice > 0 ? pos.CurrentPrice.ToString("F2") : "—";
                                    var totalStr = pos.TotalValue > 0 ? pos.TotalValue.ToString("F2") : "—";
                                    <div class="list-group-item d-flex flex-nowrap justify-content-between align-items-start gap-2 px-0">
                                        <div class="text-truncate" style="min-width: 0;">
                                            <div class="fw-bold text-truncate">@pos.Ticker</div>
                                            <small class="text-muted text-truncate d-block">@pos.SecurityName</small>
                                        </div>
                                        <div class="text-end text-nowrap ms-auto" style="min-width: 80px;">
                                            <div>@priceStr</div>
                                            <div class="@(pos.ChangePercent >= 0 ? "text-success" : "text-danger") small">
                                                @(pos.ChangePercent?.ToString("+0.00;-0.00;0.00") ?? "—")
                                            </div>
                                        </div>
                                        <div class="fw-bold text-end text-nowrap" style="min-width: 80px;">@totalStr</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Общая стоимость -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">💰 @Localizer["TotalValue"]</h5>
                        @if (summaryError != null)
                        {
                            <div class="alert alert-danger small">@summaryError</div>
                        }
                        else if (summary != null)
                        {
                            <h3 class="card-text">@summary.TotalMarketValue.ToString("C2")</h3>
                            <p class="text-muted">@Localizer["Today"]: <span class="@(summary.TodayPnL >= 0 ? "text-success" : "text-danger")">@summary.TodayPnL.ToString("C2")</span></p>
                        }
                        else
                        {
                            <p class="text-muted">@Localizer["Loading"]</p>
                        }
                    </div>
                </div>
            </div>

            <!-- P&L -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">📊 @Localizer["TotalPL"]</h5>
                        @if (summaryError != null)
                        {
                            <div class="alert alert-danger small">@summaryError</div>
                        }
                        else if (summary != null)
                        {
                            <h3 class="@(summary.TotalPnL >= 0 ? "text-success" : "text-danger")">@summary.TotalPnL.ToString("C2")</h3>
                        }
                        else
                        {
                            <p class="text-muted">@Localizer["Loading"]</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Allocation -->
            <div class="col-md-6 col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">📌 @Localizer["Allocation"]</h5>
                        @if (summaryError != null)
                        {
                            <div class="alert alert-danger small">@summaryError</div>
                        }
                        else if (summary?.Allocation != null && summary.Allocation.Count > 0)
                        {
                            @foreach (var alloc in summary.Allocation)
                            {
                                <div class="mb-2">
                                    <span>@alloc.AssetTypeName (@alloc.Percentage.ToString("F1")%)</span>
                                    <div class="progress">
                                        <div class="progress-bar" style="width: @alloc.Percentage.ToString("F1", CultureInfo.InvariantCulture)%;">@alloc.TotalValue.ToString("C2")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">@Localizer["NoData"]</p>
                        }
                    </div>
                </div>
            </div>

            <!-- История -->
            <div class="col-md-6 col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">📈 @Localizer["PortfolioHistoryTitle"]</h5>
                        @if (history == null)
                        {
                            <p class="text-muted">@Localizer["Loading"]</p>
                        }
                        else if (history.Count == 0)
                        {
                            <p class="text-muted">@Localizer["NotEnoughData"]</p>
                        }
                        else
                        {
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Date"]</th>
                                        <th class="text-end">@Localizer["PortfolioValue"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in history)
                                    {
                                        <tr>
                                            <td>@point.Date.ToString("dd.MM.yyyy")</td>
                                            <td class="text-end">@point.TotalValue.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="text-muted small mt-1">@Localizer["PortfolioHistoryHint"]</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Гостевое представление -->
        <div class="text-center mb-4">
            <h1>Investment Tracker</h1>
            <p class="lead">Персональный учёт инвестиций с рыночными данными Московской биржи</p>
            <a class="btn btn-primary" href="/login">@Localizer["Login"]</a>
            <a class="btn btn-outline-secondary ms-2" href="/register">@Localizer["Register"]</a>
        </div>

        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h5>@Localizer["MoscowExchangeIndex"]</h5>
                        <h2>@(market?.IndexValue?.ToString("F2") ?? "—")</h2>
                        <span class="@(market?.IndexChangePct >= 0 ? "text-success" : "text-danger")">
                            @(market?.IndexChangePct?.ToString("+0.00;-0.00") ?? "")%
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h5>@Localizer["Status"]</h5>
                        <h4>@market?.TradingStatus</h4>
                        <small>@Localizer["Closing"]: @market?.SessionCloseTime</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5>🚀 @Localizer["TopGainers"]</h5>
                        @if (market?.TopGainers != null)
                        {
                            <ul class="list-unstyled">
                                @foreach (var m in market.TopGainers)
                                {
                                    <li>@m.Ticker <span class="text-success">@m.ChangePct?.ToString("+0.00;-0.00")%</span></li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5>📉 @Localizer["TopLosers"]</h5>
                        @if (market?.TopLosers != null)
                        {
                            <ul class="list-unstyled">
                                @foreach (var m in market.TopLosers)
                                {
                                    <li>@m.Ticker <span class="text-danger">@m.ChangePct?.ToString("+0.00;-0.00")%</span></li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isAuthenticated;
    private bool isAdmin;
    private string? userName;
    private List<TopPositionDto>? topPositions;
    private DashboardSummaryDto? summary;
    private List<HistoryPointDto>? history;
    private MarketSnapshotDto? market;
    private string? globalError, topError, summaryError, historyError;
    private bool copied;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthState();
        if (!isAuthenticated) await LoadMarketSnapshot();
        else await LoadUserData();
    }

    private async Task UpdateAuthState()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        userName = isAuthenticated ? user.FindFirst("fullName")?.Value ?? user.FindFirst(ClaimTypes.Email)?.Value : null;
        isAdmin = isAuthenticated && user.IsInRole("Admin");
    }

    private async Task LoadUserData()
    {
        globalError = topError = summaryError = historyError = null;
        try { topPositions = await Http.GetFromJsonAsync<List<TopPositionDto>>("api/portfolio/top5") ?? new(); } catch (Exception ex) { topError = $"Top5 error: {ex.Message}"; topPositions = new(); }
        try { summary = await Http.GetFromJsonAsync<DashboardSummaryDto>("api/portfolio/summary"); } catch (Exception ex) { summaryError = $"Summary error: {ex.Message}"; summary = null; }
        try { history = await Http.GetFromJsonAsync<List<HistoryPointDto>>("api/portfolio/history") ?? new(); } catch (Exception ex) { historyError = $"History error: {ex.Message}"; history = new(); }
        StateHasChanged();
    }

    private async Task LoadMarketSnapshot()
    {
        try { market = await Http.GetFromJsonAsync<MarketSnapshotDto>("api/market/snapshot"); } catch { market = new(); }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await UpdateAuthState();
        ClearData();
        if (isAuthenticated) await LoadUserData(); else await LoadMarketSnapshot();
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        ClearData();
        isAuthenticated = false; userName = null; isAdmin = false;
        StateHasChanged();
    }

    private void ClearData()
    {
        topPositions = null; summary = null; history = null; market = null;
        globalError = topError = summaryError = historyError = null;
        // tokenDisplay больше не используется
    }

    private async Task CopyToken()
    {
        var token = await AuthService.GetToken();
        if (!string.IsNullOrEmpty(token))
        {
            await JS.InvokeVoidAsync("copyToClipboard", token);
            copied = true;
            StateHasChanged();
            await Task.Delay(3000);
            copied = false;
            StateHasChanged();
        }
    }

    public void Dispose() => AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}