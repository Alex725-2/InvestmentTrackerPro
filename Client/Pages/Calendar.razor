@page "/calendar"
@using InvestmentTracker.Shared.Models
@using InvestmentTracker.Client.Resources
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject IStringLocalizer<SharedResource> Localizer
@inject AuthenticationStateProvider AuthStateProvider

<style>
    .calendar-grid {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 4px;
        border: none;
        background: transparent;
    }

        .calendar-grid thead th {
            background: #e0e0e0;
            border-radius: 8px;
            padding: 8px 0;
            font-weight: 600;
            color: #555;
            border: none !important;
            text-align: center;
        }

    .calendar-cell {
        vertical-align: top;
        height: 80px;
        padding: 0;
        border: none !important;
        border-radius: 10px;
        background: transparent;
    }

    .empty-day {
        background-color: #f2f2f2;
    }

    .event-block {
        height: 100%;
        border-radius: 10px;
        padding: 4px 6px;
        display: flex;
        flex-direction: column;
    }

    .dividend-block {
        background: #d4edda;
    }

    .coupon-block {
        background: #cce5ff;
    }

    .amortization-block {
        background: #fff3cd;
    }

    .cell-date {
        font-size: 1.4rem;
        font-weight: 600;
        line-height: 1;
        color: #222;
    }

    .cell-tickers {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
        margin-top: auto;
    }

    .ticker-badge {
        font-size: 0.6rem;
        font-weight: 500;
        background: rgba(255,255,255,0.7);
        padding: 1px 4px;
        border-radius: 4px;
        color: #333;
    }

    .ticker-more {
        font-size: 0.6rem;
        font-weight: 600;
        color: #555;
        margin-left: 2px;
        align-self: center;
    }

    .other-month .event-block {
        opacity: 0.5;
    }
</style>

<h3>@Localizer["Calendar"]</h3>

<!-- ФИЛЬТРЫ ПО ТИПУ ВЫПЛАТ -->
<div class="mb-3">
    <div class="btn-group" role="group">
        <button class="btn btn-outline-secondary @(paymentTypeFilter == "" ? "active" : "")" @onclick='() => SetPaymentTypeFilter("")'>@Localizer["All"]</button>
        <button class="btn btn-outline-secondary @(paymentTypeFilter == "Dividend" ? "active" : "")" @onclick='() => SetPaymentTypeFilter("Dividend")'>@Localizer["Dividend"]</button>
        <button class="btn btn-outline-secondary @(paymentTypeFilter == "Coupon" ? "active" : "")" @onclick='() => SetPaymentTypeFilter("Coupon")'>@Localizer["Coupon"]</button>
        <button class="btn btn-outline-secondary @(paymentTypeFilter == "Amortization" ? "active" : "")" @onclick='() => SetPaymentTypeFilter("Amortization")'>@Localizer["Amortization"]</button>
    </div>
</div>

@if (isAuthenticated)
{
    <div class="mb-3">
        <button class="btn btn-outline-primary @(myOnly ? "active" : "")" @onclick="ToggleMyOnly">
            @(myOnly? Localizer["OnlyMySecurities"] : Localizer["AllSecurities"])
        </button>
    </div>
}
else
{
    <div class="alert alert-info">
        @Localizer["GuestMessage"]
        <a href="/login" class="btn btn-sm btn-primary ms-3">@Localizer["Login"]</a>
    </div>
}

<div class="mb-3">
    <button class="btn btn-outline-secondary @(viewMode == "calendar" ? "active" : "")" @onclick='() => SwitchView("calendar")'>📅 @Localizer["CalendarView"]</button>
    <button class="btn btn-outline-secondary ms-2 @(viewMode == "table" ? "active" : "")" @onclick='() => SwitchView("table")'>📋 @Localizer["TableView"]</button>
</div>

@if (FilteredMonthPayments != null && FilteredMonthPayments.Count > 0)
{
    <div class="mb-2 text-muted small">
        Выплаты за период:
        @FilteredMonthPayments.Min(p => p.Date).ToShortDateString() – @FilteredMonthPayments.Max(p => p.Date).ToShortDateString()
    </div>
}

@if (monthPayments == null)
{
    <p>@Localizer["Loading"]</p>
}
else if (allPayments?.Count == 0)
{
    <p>@Localizer["NoPayments"]</p>
}
else if (viewMode == "calendar")
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousMonth">←</button>
        <h5 class="mb-0">@currentMonth.ToString("MMMM yyyy")</h5>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NextMonth">→</button>
    </div>

    @if (FilteredMonthPayments.Count == 0)
    {
        <div class="alert alert-warning">В этом месяце выплат нет. Попробуйте переключить месяц.</div>
    }

    <div class="table-responsive">
        <table class="calendar-grid">
            <thead>
                <tr>
                    @foreach (var dow in daysOfWeek)
                    {
                        <th>@dow</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var week in calendarWeeks)
                {
                    <tr>
                        @foreach (var day in week)
                        {
                            var dayEvents = FilteredMonthPayments.Where(p => p.Date.Date == day.Date).ToList();
                            <CalendarCell Day="@day.Day" IsCurrentMonth="@day.IsCurrentMonth" Events="@dayEvents" Date="@day.Date" OnDayClicked="OnDayClicked" />
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (selectedDayEvents != null && selectedDayEvents.Any())
    {
        <div class="mt-4">
            <h5>@selectedDate?.ToString("dd MMMM yyyy")</h5>
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th>Тикер</th>
                        <th>Наименование</th>
                        <th>Тип</th>
                        <th>Сумма на ед.</th>
                        <th>Валюта</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in selectedDayEvents)
                    {
                        <tr>
                            <td><a href="/bond/@evt.Ticker" target="_blank">@evt.Ticker</a></td>
                            <td>@evt.SecurityName</td>
                            <td>@GetLocalizedType(evt.Type)</td>
                            <td>@evt.AmountPerUnit.ToString("F2")</td>
                            <td>@evt.Currency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (isAuthenticated && myOnly && FilteredMonthPayments.Count > 0)
    {
        var today = DateTime.Today;
        var paid = FilteredMonthPayments.Where(p => p.Date < today).ToList();
        var upcoming = FilteredMonthPayments.Where(p => p.Date >= today).ToList();
        var totalPaid = paid.Sum(p => p.UserTotalAmount ?? p.AmountPerUnit);
        var totalUpcoming = upcoming.Sum(p => p.UserTotalAmount ?? p.AmountPerUnit);
        var totalAll = totalPaid + totalUpcoming;

        <div class="mt-4">
            <h5>@Localizer["PaymentHistory"]</h5>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Всего выплат в периоде
                    <span class="badge bg-primary rounded-pill">@totalAll.ToString("C2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center" title="@GetPaidTooltip(paid)">
                    Уже выплачено
                    <span class="badge bg-success rounded-pill">@totalPaid.ToString("C2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center" title="@GetUpcomingTooltip(upcoming)">
                    Еще будет выплачено
                    <span class="badge bg-warning text-dark rounded-pill">@totalUpcoming.ToString("C2")</span>
                </li>
            </ul>
        </div>
    }
}
else
{
    var orderedList = FilteredMonthPayments.OrderBy(p => p.Date).ToList();

    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Date"]</th>
                <th>@Localizer["Ticker"]</th>
                <th>@Localizer["PaymentType"]</th>
                <th>@Localizer["AmountPerUnit"]</th>
                @if (isAuthenticated && myOnly)
                {
                    <th>@Localizer["UserAmount"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in orderedList)
            {
                <tr>
                    <td>@p.Date.ToShortDateString()</td>
                    <td>@p.Ticker</td>
                    <td>@GetLocalizedType(p.Type)</td>
                    <td>@p.AmountPerUnit.ToString("F2") @p.Currency</td>
                    @if (isAuthenticated && myOnly)
                    {
                        <td>@(p.UserTotalAmount?.ToString("F2") ?? "—") @p.Currency</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PaymentEventDto>? allPayments;
    private List<PaymentEventDto>? monthPayments;
    private bool myOnly;
    private bool isAuthenticated;
    private string viewMode = "calendar";
    private DateTime currentMonth;
    private List<List<CalendarDay>> calendarWeeks = new();
    private string[] daysOfWeek = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };
    private string paymentTypeFilter = "";
    private DateTime? selectedDate;
    private List<PaymentEventDto>? selectedDayEvents;

    private void OnDayClicked(DateTime date)
    {
        selectedDate = date;
        selectedDayEvents = FilteredMonthPayments.Where(p => p.Date.Date == date.Date).ToList();
        StateHasChanged();
    }
    private void SetPaymentTypeFilter(string type)
    {
        paymentTypeFilter = type;
        // Фильтрация происходит на клиенте мгновенно
    }

    private List<PaymentEventDto> FilteredMonthPayments =>
        string.IsNullOrEmpty(paymentTypeFilter)
            ? (monthPayments ?? new())
            : (monthPayments ?? new()).Where(p => p.Type == paymentTypeFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        myOnly = isAuthenticated;
        currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        await LoadAllPayments();
        await LoadMonthPayments();
        BuildCalendar();
    }

    private async Task LoadAllPayments()
    {
        try
        {
            var url = $"api/payments/upcoming?count=1000&myOnly={myOnly.ToString().ToLower()}";
            allPayments = await Http.GetFromJsonAsync<List<PaymentEventDto>>(url) ?? new();
        }
        catch { allPayments = new(); }
    }

    private async Task LoadMonthPayments()
    {
        try
        {
            var url = $"api/payments/upcoming?count=500&myOnly={myOnly.ToString().ToLower()}&year={currentMonth.Year}&month={currentMonth.Month}";
            monthPayments = await Http.GetFromJsonAsync<List<PaymentEventDto>>(url) ?? new();
        }
        catch { monthPayments = new(); }
    }

    private void BuildCalendar()
    {
        var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);
        var start = firstDay.AddDays(-(((int)firstDay.DayOfWeek - 1 + 7) % 7));
        var end = lastDay.AddDays(7 - ((int)lastDay.DayOfWeek % 7));

        calendarWeeks.Clear();
        var current = start;
        while (current <= end)
        {
            var week = new List<CalendarDay>();
            for (int i = 0; i < 7; i++)
            {
                week.Add(new CalendarDay { Date = current, Day = current.Day, IsCurrentMonth = current.Month == currentMonth.Month });
                current = current.AddDays(1);
            }
            calendarWeeks.Add(week);
        }
    }

    private async Task PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadMonthPayments();
        BuildCalendar();
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadMonthPayments();
        BuildCalendar();
    }

    private void SwitchView(string mode)
    {
        viewMode = mode;
        if (mode == "calendar") BuildCalendar();
        StateHasChanged();
    }

    private async Task ToggleMyOnly()
    {
        myOnly = !myOnly;
        await LoadAllPayments();
        await LoadMonthPayments();
        BuildCalendar();
    }

    private string GetPaidTooltip(List<PaymentEventDto> events) =>
        string.Join("\n", events.Select(e => $"{e.Ticker}: {e.UserTotalAmount ?? e.AmountPerUnit:F2} {e.Currency}"));
    private string GetUpcomingTooltip(List<PaymentEventDto> events) =>
        string.Join("\n", events.Select(e => $"{e.Ticker}: {e.UserTotalAmount ?? e.AmountPerUnit:F2} {e.Currency}"));

    private string GetLocalizedType(string type) => type switch
    {
        "Dividend" => "Дивиденд",
        "Coupon" => "Купон",
        "Amortization" => "Амортизация",
        _ => type
    };

    public class CalendarDay
    {
        public DateTime Date { get; set; }
        public int Day { get; set; }
        public bool IsCurrentMonth { get; set; }
    }
}